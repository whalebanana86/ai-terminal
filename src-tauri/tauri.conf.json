{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "코드행방",
  "version": "0.10.2",
  "identifier": "dev.aiterminal.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "코드행방 - AI가 어디서 무엇을 바꾸는지",
        "width": 1480,
        "height": 920,
        "minWidth": 980,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0b0d11",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "See where AI works and what it changes",
    "copyright": "MIT License",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": {
      "locales/ko.lproj/InfoPlist.strings": "ko.lproj/InfoPlist.strings",
      "locales/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzMEY0MDhEQkJGNTIxQzQKUldURUlmVzdqVUFQSTc0d1FrVGRCZlBNWUtyZGZ6ZWtUSWxIVFJMbDZjT1BWekdWVWNBQmorWTkK",
      "endpoints": [
        "https://github.com/whalebanana86/ai-terminal/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
